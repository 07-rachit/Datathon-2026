# ─── Backend ────────────────────────────────────────────────────────────────
# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production

# Database connection string
# SQLite (local dev): sqlite:///./crime_intel.db
# PostgreSQL (local): postgresql+psycopg2://user:password@localhost:5432/crime_intel
# Supabase (Direct):   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Supabase (Pooler):   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./crime_intel.db

# Anthropic API key — required for AI-generated answers in the chat assistant
# Without this, the assistant still returns retrieved case snippets
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Dev:  http://localhost:5173
# Prod: https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173

# ─── Rate limiting ──────────────────────────────────────────────────────────
# slowapi limit strings — see https://limits.readthedocs.io/
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute
